# Generate with: npx auth secret
AUTH_SECRET=
# From Google Cloud Console > APIs & Services > Credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated emails that can manage users at /admin (they can always sign in)
ADMIN_EMAILS=
# Comma-separated emails allowed to sign in (more can be added at /admin)
ALLOWED_EMAILS=
# Added automatically by the Upstash Redis integration in Vercel
KV_REST_API_URL=
KV_REST_API_TOKEN=
